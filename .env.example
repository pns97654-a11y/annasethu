# --- Database ---
# Local dev default (SQLite, zero config):
DATABASE_URL="file:./dev.db"
# For production, switch the datasource provider in prisma/schema.prisma to "postgresql"
# and point this at your Postgres instance instead, e.g.:
# DATABASE_URL="postgresql://user:password@host:5432/annasethu"

# --- Auth / Sessions ---
# Random long string used to sign session cookies. Generate with:
#   openssl rand -base64 48
SESSION_SECRET="replace-this-with-a-long-random-string"

# --- App ---
NEXT_PUBLIC_APP_NAME="Annasethu"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Future integrations (Phase 2/3, not wired up yet) ---
# Map provider abstraction (see lib/maps.ts)
MAPS_PROVIDER="none"          # "none" | "mapbox" | "google" | "osm"
MAPS_API_KEY=""

# Notifications (email/SMS/WhatsApp abstraction, see lib/notify.ts)
EMAIL_PROVIDER="none"         # "none" | "resend" | "sendgrid" | "ses"
EMAIL_API_KEY=""
SMS_PROVIDER="none"           # "none" | "twilio" | "whatsapp-business"
SMS_API_KEY=""

# Payments (sponsor funding, see lib/payments.ts) — architecture only, not implemented
PAYMENTS_PROVIDER="none"      # "none" | "stripe" | "razorpay"
PAYMENTS_API_KEY=""

# Object storage for donation photos / org documents (see lib/storage.ts)
STORAGE_PROVIDER="local"      # "local" | "s3" | "gcs"
STORAGE_BUCKET=""
